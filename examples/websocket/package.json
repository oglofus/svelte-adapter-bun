{
  "name": "websocket",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "bun --bun run vite dev",
    "build": "bun --bun run vite build",
    "start": "bun build/index.js",
    "preview": "bun --bun run vite preview",
    "prepare": "bun --bun run svelte-kit sync",
    "check": "bun --bun run svelte-kit sync && bun --bun run svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "bun --bun run svelte-kit sync && bun --bun run svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@oglofus/svelte-adapter-bun": "file:../../svelte-adapter-bun.tgz",
    "@sveltejs/kit": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/bun": "1.4.2",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.2"
  }
}
